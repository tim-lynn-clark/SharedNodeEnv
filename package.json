{
  "name": "shared-node-env",
  "version": "1.0.4",
  "description": "A Node.js library designed to handle the creation of shared Environment Variables within multiple node applications running on the same server and sharing identical environmental variables that must be updated across all applications when changed.",
  "main": "index.js",
  "files": [
    "index.js",
    "src/"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "scan": "gitleaks git --no-banner --redact -c .gitleaks.toml .",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85",
    "test:package": "RUN_PACKAGE_TESTS=1 node --test test/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schleichermann/SharedNodeEnv.git"
  },
  "keywords": [
    "Node.js",
    "Environment",
    "Variables",
    "Shared",
    "Environment",
    "Variables"
  ],
  "author": "Tim Clark <graphicnetdesign@gmail.com> (http://violentatom.com)",
  "license": "GNU GENERAL PUBLIC LICENSE",
  "bugs": {
    "url": "https://github.com/schleichermann/SharedNodeEnv/issues"
  },
  "homepage": "https://github.com/schleichermann/SharedNodeEnv",
  "dependencies": {
    "underscore": "^1.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  }
}
